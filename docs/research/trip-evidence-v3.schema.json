{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravradar.dk/schemas/trip-evidence-v3.schema.json",
  "title": "RavRadar integrated-model trip evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "tripId", "tripStartedAt", "tripEndedAt", "observedAt",
    "searchMinutes", "searchCoverage", "mode", "zoneId", "coastalPartId",
    "forecastZoneId", "forecastCoastalPartId", "calibrationEligible", "found",
    "grams", "forecastSnapshotId", "forecastIssuedAt", "forecastValidAt",
    "forecastCapturedAt", "calibrationFeatures"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "tripId": { "type": "string", "format": "uuid" },
    "tripStartedAt": { "$ref": "#/$defs/dateTime" },
    "tripEndedAt": { "$ref": "#/$defs/dateTime" },
    "observedAt": { "$ref": "#/$defs/dateTime" },
    "searchMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "searchCoverage": { "enum": ["partial", "normal", "thorough"] },
    "mode": { "enum": ["waders", "beach"] },
    "zoneId": { "$ref": "#/$defs/id" },
    "coastalPartId": { "$ref": "#/$defs/id" },
    "forecastZoneId": { "$ref": "#/$defs/id" },
    "forecastCoastalPartId": { "$ref": "#/$defs/id" },
    "calibrationEligible": { "type": "boolean" },
    "found": { "type": "boolean" },
    "grams": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 10000 }
      ]
    },
    "forecastSnapshotId": { "$ref": "#/$defs/id" },
    "forecastIssuedAt": { "$ref": "#/$defs/dateTime" },
    "forecastValidAt": { "$ref": "#/$defs/dateTime" },
    "forecastCapturedAt": { "$ref": "#/$defs/dateTime" },
    "calibrationFeatures": { "$ref": "#/$defs/calibrationFeatures" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullable0to100": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 100 }
      ]
    },
    "nullableDirection": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 360 }
      ]
    },
    "nullableWaveHeight": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 30 }
      ]
    },
    "nullableWavePeriod": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 40 }
      ]
    },
    "nullableCurrentSpeed": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 10 }
      ]
    },
    "nullableWaterLevel": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": -20, "maximum": 20 }
      ]
    },
    "nullableWaterTrend": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": -10, "maximum": 10 }
      ]
    },
    "nullableHours": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 168 }
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "calibrationFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelVersion", "appVersion", "modelStateVersion", "modelVariantId",
        "modelProfileId", "modelComponentSchemaId", "modelExplanationSchemaId",
        "modelRankingPolicyId", "modelBestTimePolicyId", "modelPresentationPolicyId",
        "modelContractSha256", "modelBundleSha256", "totalScore", "huntabilityScore", "transportScore",
        "mobilisationScore", "windSpeedMs", "windDirectionDeg", "waveHeightM",
        "wavePeriodS", "waveDirectionDeg", "currentSpeedMs", "currentDirectionDeg",
        "waterLevelM", "waterLevelTrendM3h", "maxWaveHeight24hM",
        "hoursSinceEnergyPeak", "sustainedOnshoreHours", "reasonCodes"
      ],
      "properties": {
        "modelVersion": { "$ref": "#/$defs/id" },
        "appVersion": { "$ref": "#/$defs/id" },
        "modelStateVersion": { "$ref": "#/$defs/id" },
        "modelVariantId": { "$ref": "#/$defs/id" },
        "modelProfileId": { "$ref": "#/$defs/id" },
        "modelComponentSchemaId": { "$ref": "#/$defs/id" },
        "modelExplanationSchemaId": { "$ref": "#/$defs/id" },
        "modelRankingPolicyId": { "$ref": "#/$defs/id" },
        "modelBestTimePolicyId": { "$ref": "#/$defs/id" },
        "modelPresentationPolicyId": { "$ref": "#/$defs/id" },
        "modelContractSha256": { "$ref": "#/$defs/sha256" },
        "modelBundleSha256": { "$ref": "#/$defs/sha256" },
        "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "huntabilityScore": { "$ref": "#/$defs/score" },
        "transportScore": { "$ref": "#/$defs/score" },
        "mobilisationScore": { "$ref": "#/$defs/score" },
        "windSpeedMs": { "$ref": "#/$defs/nullable0to100" },
        "windDirectionDeg": { "$ref": "#/$defs/nullableDirection" },
        "waveHeightM": { "$ref": "#/$defs/nullableWaveHeight" },
        "wavePeriodS": { "$ref": "#/$defs/nullableWavePeriod" },
        "waveDirectionDeg": { "$ref": "#/$defs/nullableDirection" },
        "currentSpeedMs": { "$ref": "#/$defs/nullableCurrentSpeed" },
        "currentDirectionDeg": { "$ref": "#/$defs/nullableDirection" },
        "waterLevelM": { "$ref": "#/$defs/nullableWaterLevel" },
        "waterLevelTrendM3h": { "$ref": "#/$defs/nullableWaterTrend" },
        "maxWaveHeight24hM": { "$ref": "#/$defs/nullableWaveHeight" },
        "hoursSinceEnergyPeak": { "$ref": "#/$defs/nullableHours" },
        "sustainedOnshoreHours": { "$ref": "#/$defs/nullableHours" },
        "reasonCodes": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
